{
  "name": "yu-desktop",
  "productName": "Yeu",
  "version": "1.0.1",
  "description": "ユー desktop app (screen-capture protected)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "build": {
    "appId": "dev.yeu-terminal.desktop",
    "productName": "Yeu",
    "files": [
      "main.js",
      "preload.js",
      "app-secret.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "ユー",
      "artifactName": "Yeu-Setup-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Yeu-Mac-${version}.dmg",
      "title": "ユー"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
